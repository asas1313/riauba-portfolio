---
import { cvForBuild } from "../lib/cv.publish.ts";

const year = new Date().getFullYear();
const linkedIn = cvForBuild.basics.profiles.find(
  (profile) => profile.network.trim().toLowerCase() === "linkedin",
);
---

<footer class="site-footer">
  <p>
    <a href={`mailto:${cvForBuild.basics.email}`}>{cvForBuild.basics.email}</a>
    {linkedIn && (
      <>
        {" "}
        · <a href={linkedIn.url}>LinkedIn</a>
      </>
    )}
  </p>
  <p>
    © {year} {cvForBuild.basics.name}
  </p>
</footer>
